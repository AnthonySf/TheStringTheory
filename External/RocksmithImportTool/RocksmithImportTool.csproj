<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(UseRocksmithNet10)' != 'true'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(UseRocksmithNet10)' == 'true'">net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\Rocksmith2014.NET\\src\\Rocksmith2014.Audio\\Rocksmith2014.Audio.fsproj" />
    <ProjectReference Include="..\\Rocksmith2014.NET\\src\\Rocksmith2014.DLCProject\\Rocksmith2014.DLCProject.fsproj" />
    <ProjectReference Include="..\\Rocksmith2014.NET\\src\\Rocksmith2014.XML\\Rocksmith2014.XML.csproj" />
    <ProjectReference Include="..\\Rocksmith2014.NET\\src\\Rocksmith2014.XML.Processing\\Rocksmith2014.XML.Processing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>

</Project>
