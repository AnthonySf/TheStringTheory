.hud-root {
    flex-grow: 1;
    padding-top: 18px;
    padding-left: 24px;
    padding-right: 24px;
    align-items: flex-start;
    justify-content: flex-start;
}

.song-card {
    min-width: 360px;
    max-width: 760px;
    padding-top: 10px;
    padding-right: 16px;
    padding-bottom: 10px;
    padding-left: 16px;

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;

    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;

    border-top-color: rgba(97, 156, 217, 0.70);
    border-right-color: rgba(58, 80, 112, 0.70);
    border-bottom-color: rgba(58, 80, 112, 0.70);
    border-left-color: rgba(58, 80, 112, 0.70);

    background-color: rgba(15, 21, 31, 0.82);
}

.song-name {
    color: rgba(242, 250, 255, 1);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    margin-bottom: 3px;
}

.track-name {
    color: rgba(189, 217, 250, 0.95);
    font-size: 16px;
}
