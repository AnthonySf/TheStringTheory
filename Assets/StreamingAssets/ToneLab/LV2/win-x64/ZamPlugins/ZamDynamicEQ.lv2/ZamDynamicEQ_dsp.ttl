@prefix dg:    <http://www.darkglass.com/lv2/ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<urn:zamaudio:ZamDynamicEQ>
    a lv2:EQPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <urn:zamaudio:ZamDynamicEQ#DPF_UI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_sidechain_in" ;
        lv2:name "Sidechain Input" ;
        lv2:portProperty lv2:isSideChain;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:name "Attack" ;
        lv2:symbol "att" ;
        lv2:default 10 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 100 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Release" ;
        lv2:symbol "rel" ;
        lv2:default 80 ;
        lv2:minimum 1 ;
        lv2:maximum 500 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Knee" ;
        lv2:symbol "kn" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Ratio" ;
        lv2:symbol "rat" ;
        lv2:default 1.5 ;
        lv2:minimum 1 ;
        lv2:maximum 5 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Threshold" ;
        lv2:symbol "thr" ;
        lv2:default 0 ;
        lv2:minimum -80 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Max Boost/Cut" ;
        lv2:symbol "max" ;
        lv2:default 10 ;
        lv2:minimum 0 ;
        lv2:maximum 10 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Slew" ;
        lv2:symbol "slew" ;
        lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 150 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "Sidechain" ;
        lv2:symbol "sidech" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "Low Shelf" ;
        lv2:symbol "togglelow" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "Peak" ;
        lv2:symbol "togglepeak" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "High Shelf" ;
        lv2:symbol "togglehigh" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:name "Detect Frequency" ;
        lv2:symbol "detectfreq" ;
        lv2:default 1000 ;
        lv2:minimum 20 ;
        lv2:maximum 16000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:name "Target Frequency" ;
        lv2:symbol "targetfreq" ;
        lv2:default 1000 ;
        lv2:minimum 20 ;
        lv2:maximum 16000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:name "Target width" ;
        lv2:symbol "targetwidth" ;
        lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 5 ;
        unit:unit [
            a unit:Unit ;
            rdfs:label  "oct" ;
            unit:symbol "oct" ;
            unit:render "%f oct" ;
        ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:name "Boost / Cut" ;
        lv2:symbol "boostcut" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:name "Control Gain" ;
        lv2:symbol "controlgain" ;
        lv2:minimum -10 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ;

    rdfs:comment "Mono dynamic EQ" ;

    mod:brand "ZamAudio" ;
    mod:label "ZamDynamicEQ" ;

    doap:name "ZamDynamicEQ" ;
    doap:license <http://spdx.org/licenses/GPL-2.0-or-later.html> ;

    doap:maintainer [
        foaf:name "Damien Zammit" ;
        foaf:homepage <http://www.zamaudio.com> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 7 .
