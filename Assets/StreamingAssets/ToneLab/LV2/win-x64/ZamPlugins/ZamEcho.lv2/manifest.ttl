@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:zamaudio:ZamEcho>
    a lv2:Plugin ;
    lv2:binary <ZamEcho_dsp.dll> ;
    rdfs:seeAlso <ZamEcho_dsp.ttl> .

<urn:zamaudio:ZamEcho#DPF_UI>
    a ui:WindowsUI ;
    ui:binary <ZamEcho_ui.dll> ;
    rdfs:seeAlso <ZamEcho_ui.ttl> .

<urn:zamaudio:ZamEcho#preset001>
    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamEcho> ;
    rdfs:label "Zero" ;
    rdfs:seeAlso <presets.ttl> .

