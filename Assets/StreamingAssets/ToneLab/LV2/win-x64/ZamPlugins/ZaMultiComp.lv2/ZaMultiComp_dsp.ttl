@prefix dg:    <http://www.darkglass.com/lv2/ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<urn:zamaudio:ZaMultiComp>
    a lv2:DynamicsPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <urn:zamaudio:ZaMultiComp#DPF_UI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:name "Attack1" ;
        lv2:symbol "att1" ;
        lv2:default 10 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 100 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:name "Attack2" ;
        lv2:symbol "att2" ;
        lv2:default 10 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 100 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Attack3" ;
        lv2:symbol "att3" ;
        lv2:default 10 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 100 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Release1" ;
        lv2:symbol "rel1" ;
        lv2:default 80 ;
        lv2:minimum 1 ;
        lv2:maximum 500 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Release2" ;
        lv2:symbol "rel2" ;
        lv2:default 80 ;
        lv2:minimum 1 ;
        lv2:maximum 500 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Release3" ;
        lv2:symbol "rel3" ;
        lv2:default 80 ;
        lv2:minimum 1 ;
        lv2:maximum 500 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Knee1" ;
        lv2:symbol "kn1" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Knee2" ;
        lv2:symbol "kn2" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "Knee3" ;
        lv2:symbol "kn3" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "Ratio1" ;
        lv2:symbol "rat1" ;
        lv2:default 4 ;
        lv2:minimum 1 ;
        lv2:maximum 20 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "Ratio2" ;
        lv2:symbol "rat2" ;
        lv2:default 4 ;
        lv2:minimum 1 ;
        lv2:maximum 20 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "Ratio3" ;
        lv2:symbol "rat3" ;
        lv2:default 4 ;
        lv2:minimum 1 ;
        lv2:maximum 20 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:name "Threshold 1" ;
        lv2:symbol "thr1" ;
        lv2:default -20 ;
        lv2:minimum -60 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:name "Threshold 2" ;
        lv2:symbol "thr2" ;
        lv2:default -18 ;
        lv2:minimum -60 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:name "Threshold 3" ;
        lv2:symbol "thr3" ;
        lv2:default -16 ;
        lv2:minimum -60 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:name "Makeup 1" ;
        lv2:symbol "mak1" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 30 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:name "Makeup 2" ;
        lv2:symbol "mak2" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 30 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:name "Makeup 3" ;
        lv2:symbol "mak3" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 30 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:name "Crossover freq 1" ;
        lv2:symbol "xover1" ;
        lv2:default 160 ;
        lv2:minimum 20 ;
        lv2:maximum 1400 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:name "Crossover freq 2" ;
        lv2:symbol "xover2" ;
        lv2:default 1400 ;
        lv2:minimum 1400 ;
        lv2:maximum 14000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:name "ZamComp 1 ON" ;
        lv2:symbol "toggle1" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:name "ZamComp 2 ON" ;
        lv2:symbol "toggle2" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:name "ZamComp 3 ON" ;
        lv2:symbol "toggle3" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:name "Listen 1" ;
        lv2:symbol "listen1" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:name "Listen 2" ;
        lv2:symbol "listen2" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:name "Listen 3" ;
        lv2:symbol "listen3" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:name "Master Trim" ;
        lv2:symbol "globalgain" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:name "Output" ;
        lv2:symbol "out" ;
        lv2:minimum -45 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:name "Output low" ;
        lv2:symbol "outlo" ;
        lv2:minimum -45 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:name "Output medium" ;
        lv2:symbol "outmed" ;
        lv2:minimum -45 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:name "Output high" ;
        lv2:symbol "outhi" ;
        lv2:minimum -45 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:name "Gain Reduction 1" ;
        lv2:symbol "gr1" ;
        lv2:minimum 0 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:name "Gain Reduction 2" ;
        lv2:symbol "gr2" ;
        lv2:minimum 0 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:name "Gain Reduction 3" ;
        lv2:symbol "gr3" ;
        lv2:minimum 0 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ;

    rdfs:comment "Mono multiband compressor, with 3 adjustable bands." ;

    mod:brand "ZamAudio" ;
    mod:label "ZaMultiComp" ;

    doap:name "ZaMultiComp" ;
    doap:license <http://spdx.org/licenses/GPL-2.0-or-later.html> ;

    doap:maintainer [
        foaf:name "Damien Zammit" ;
        foaf:homepage <http://www.zamaudio.com> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 7 .
