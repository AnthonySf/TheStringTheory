@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:zamaudio:ZamNoise>
    a lv2:Plugin ;
    lv2:binary <ZamNoise_dsp.dll> ;
    rdfs:seeAlso <ZamNoise_dsp.ttl> .

<urn:zamaudio:ZamNoise#DPF_UI>
    a ui:WindowsUI ;
    ui:binary <ZamNoise_ui.dll> ;
    rdfs:seeAlso <ZamNoise_ui.ttl> .

<urn:zamaudio:ZamNoise#preset001>
    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamNoise> ;
    rdfs:label "Default" ;
    rdfs:seeAlso <presets.ttl> .

