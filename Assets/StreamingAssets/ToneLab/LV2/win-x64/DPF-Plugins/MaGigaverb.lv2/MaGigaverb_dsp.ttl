@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<http://distrho.sf.net/plugins/MaGigaverb>
    a lv2:ReverbPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ;

    lv2:optionalFeature <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
        pg:group <http://distrho.sf.net/plugins/MaGigaverb#portGroup_dpf_stereo> ;
        lv2:designation pg:left ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
        pg:group <http://distrho.sf.net/plugins/MaGigaverb#portGroup_dpf_stereo> ;
        lv2:designation pg:right ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
        pg:group <http://distrho.sf.net/plugins/MaGigaverb#portGroup_dpf_stereo> ;
        lv2:designation pg:left ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
        pg:group <http://distrho.sf.net/plugins/MaGigaverb#portGroup_dpf_stereo> ;
        lv2:designation pg:right ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "damping" ;
        lv2:symbol "damping" ;
        lv2:default 0.699999988079 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "revtime" ;
        lv2:symbol "revtime" ;
        lv2:default 11 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 360 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "roomsize" ;
        lv2:symbol "roomsize" ;
        lv2:default 75 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 300 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "spread" ;
        lv2:symbol "spread" ;
        lv2:default 23 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "bandwidth" ;
        lv2:symbol "bandwidth" ;
        lv2:default 0.5 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "tail" ;
        lv2:symbol "tail" ;
        lv2:default 0.25 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "dry" ;
        lv2:symbol "dry" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "early" ;
        lv2:symbol "early" ;
        lv2:default 0.25 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ;

    rdfs:comment "Max Gen Gigaverb example." ;

    mod:brand "DISTRHO" ;
    mod:label "MaGigaverb" ;

    doap:name "MaGigaverb" ;
    doap:license <http://spdx.org/licenses/ISC.html> ;

    doap:maintainer [
        foaf:name "DISTRHO" ;
        foaf:homepage <https://github.com/DISTRHO/DPF-Max-Gen> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 1 .

<http://distrho.sf.net/plugins/MaGigaverb#portGroup_dpf_stereo>
    a pg:Group , pg:StereoGroup ;
    lv2:name "Stereo" ;
    lv2:symbol "dpf_stereo" .
