@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://distrho.sf.net/plugins/PingPongPan>
    a lv2:Plugin ;
    lv2:binary <PingPongPan_dsp.dll> ;
    rdfs:seeAlso <PingPongPan_dsp.ttl> .

<http://distrho.sf.net/plugins/PingPongPan#DPF_UI>
    a ui:WindowsUI ;
    ui:binary <PingPongPan_ui.dll> ;
    rdfs:seeAlso <PingPongPan_ui.ttl> .

<http://distrho.sf.net/plugins/PingPongPan#preset001>
    a pset:Preset ;
    lv2:appliesTo <http://distrho.sf.net/plugins/PingPongPan> ;
    rdfs:label "Default" ;
    rdfs:seeAlso <presets.ttl> .

